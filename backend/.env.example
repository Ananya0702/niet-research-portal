# ═══ DATABASE ═════════════════════════════════════════════════════════════════
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=niet_research

# ═══ EXTERNAL EMAIL OTP API (password change) ════════════════════════════════
# Base URL of the standalone Email OTP service the portal delegates to for
# change-password verification. The portal never generates or stores OTPs; it
# calls POST /send-otp and POST /verify-otp on this service and enforces its own
# rate limits / attempt caps / resend cooldown locally.
OTP_API_BASE_URL=http://127.0.0.1:8001

# ═══ EMAIL OTP DELIVERY (current channel — SMTP) ═════════════════════════════
# The only email provider. When SMTP_HOST is set, OTPs are emailed for real;
# otherwise they fall back to the backend log (dev mode) — never an API response.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@niet.co.in
SMTP_FROM_NAME=NIET Research Analytics Portal
SMTP_TLS=1

# ═══ SMS OTP DELIVERY (optional — pick ONE provider, SMS enables automatically) ══
# As soon as any block below is filled, the Mobile OTP method appears and OTPs
# are delivered as real SMS. Priority when several are set: Twilio > MSG91 >
# Fast2SMS > AWS SNS > Generic HTTP.

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# MSG91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=4

# Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=

# AWS SNS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SNS_SENDER_ID=

# Generic HTTP gateway (catch-all for any other REST SMS API)
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER=

# ═══ MISC ════════════════════════════════════════════════════════════════════
SECRET_KEY=
LOG_LEVEL=INFO
