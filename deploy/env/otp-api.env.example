# Email OTP API — production environment.
# COPY to deploy/env/otp-api.env (VPS) or paste into Railway variables (Phase 1).
#
# EMAIL_APP_PASSWORD is a Gmail App Password (Google Account → Security →
# 2-Step Verification → App passwords), NOT the normal Gmail password.

EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
