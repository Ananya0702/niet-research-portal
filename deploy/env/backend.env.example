# Main FastAPI backend — production environment.
# COPY to deploy/env/backend.env (VPS) or paste into Railway variables (Phase 1).

# ── Database ──────────────────────────────────────────────────────────────
# VPS (compose): DB_HOST/DB_PORT/DB_SSL are overridden by docker-compose.yml.
DB_USER=niet
DB_PASSWORD=change_me_app_password
DB_NAME=niet_research

# Phase 1 managed MySQL (Aiven / Railway public proxy): set host + port here.
# DB_HOST=your-service.aivencloud.com
# DB_PORT=12345

# Managed providers usually require TLS. Set true and optionally point
# DB_SSL_CA at the provider CA certificate for full verification.
DB_SSL=true
# DB_SSL_CA=/certs/ca.pem

# SQL echo logging — keep false in production.
DB_ECHO=false

# ── Security ──────────────────────────────────────────────────────────────
# JWT signing key. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_and_paste_a_long_random_value

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed by the browser.
CORS_ORIGINS=https://your-frontend.vercel.app

# ── Email OTP service ─────────────────────────────────────────────────────
# Phase 1 (Railway internal URL or public URL of the OTP service):
# OTP_API_BASE_URL=https://niet-otp-api.up.railway.app
# VPS (compose overrides this to the internal name):
OTP_API_BASE_URL=http://otp-api:8001

LOG_LEVEL=INFO
